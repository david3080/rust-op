theory CompositionCibaDpopRar
begin

/*
  backlog #2: 合成（#3 CIBA 切り離し承認 × #3 RAR マンデート × #2 DPoP 送り主束縛）
  rust-op の CIBA ログイン（confidential client = private_key_jwt、トークンは DPoP 束縛、
  authorization_details = mandate）。「切り離し承認 + 送り主束縛 + マンデート束縛」の end-to-end。

  検証する性質（エンドツーエンドのリソース秘匿）:
    正規ユーザ U の保護リソースは、DPoP 鍵もユーザ鍵も漏れない限り攻撃者に漏れない。
    依存: ユーザ承認の mandate 束縛(#3) + クライアント認証 + cnf.jkt(#2) + マンデート単回(#3)。
    → cnf を外せば盗難トークンが通り falsify、mandate 束縛を外せば表示すり替えで falsify（NEG 変種で確認）。

  攻撃者: Dolev-Yao。**ユーザ通知チャネルを操作可（表示すり替え）**かつ**トークン窃取可**。
  抽象: passkey = ユーザ署名鍵。binding_message/mandate = 値 m。リソース配送は requester 鍵への暗号化で抽象化。

  実行: tamarin-prover --prove --auto-sources formal/composition_ciba_dpop_rar.spthy
*/

builtins: hashing, signing, asymmetric-encryption

/* ---- ユーザの認証鍵（passkey）---- */
rule Setup_User:
    [ Fr(~uk) ] --[ ]-> [ !UserKey($U, ~uk), !UserPub($U, pk(~uk)), Out(pk(~uk)) ]
rule Reveal_User:
    [ !UserKey($U, ~uk) ] --[ RevealUser($U) ]-> [ Out(~uk) ]

/* ---- confidential client（消費デバイス = ciba-rp, private_key_jwt）---- */
rule Setup_Client:
    [ Fr(~ck) ] --[ ]-> [ !ClientKey($Cl, ~ck), !ClientPub($Cl, pk(~ck)), Out(pk(~ck)) ]

/* ---- RS の保護リソース（正規ユーザ $U のもの）---- */
rule Setup_Resource:
    [ Fr(~res) ] --[ Protected($U, ~res) ]-> [ !Resource($U, ~res) ]

/* ---- クライアント: CIBA backchannel 要求（mandate ~m, ユーザ $U 宛, クライアント認証）---- */
rule C_Backchannel:
    [ !ClientKey($Cl, ~ck), Fr(~m) ]
  --[ ClientRequest($Cl, $U, ~m) ]->
    [ Out( <'backchannel', $Cl, $U, ~m, sign(<'backchannel', $Cl, $U, ~m>, ~ck)> ) ]

/* ---- AS: クライアント認証 → pending(linear=単回) → ユーザ通知 + 起案クライアントへ arid ----
   通知は In/Out（ネットワーク）＝攻撃者が m をすり替え可能（表示すり替えの脅威）。 */
rule AS_Backchannel:
    [ In( <'backchannel', Cl, U, m, sig> ), !ClientPub(Cl, cpk), Fr(~arid) ]
  --[ Eq(verify(sig, <'backchannel', Cl, U, m>, cpk), true)
    , CreatePending(Cl, U, ~arid, m) ]->
    [ Pending(~arid, Cl, U, m)
    , Out( <'notify', ~arid, Cl, m> )
    , Out( <'bcresp', Cl, ~arid> )
    ]

/* ---- ユーザ: 見た mandate(mseen) に passkey で署名して承認（“見たもの”に commit）---- */
rule U_Approve:
    [ !UserKey(U, ~uk), In( <'notify', arid, Cl, mseen> ) ]
  --[ UserApproved(U, arid, mseen) ]->
    [ Out( <'approval', arid, mseen, sign(<'approve', arid, mseen>, ~uk)> ) ]

/* ---- クライアント: token endpoint をポーリング。新鮮な DPoP 鍵 ~dk を提示 + クライアント認証 ---- */
rule C_PollToken:
    [ !ClientKey(Cl, ~ck), In( <'bcresp', Cl, arid> ), Fr(~dk) ]
  --[ ]->
    [ !CDk(Cl, ~dk)
    , Out( <'tokenpoll', Cl, arid, pk(~dk),
            sign(<'tokenpoll', Cl, arid, pk(~dk)>, ~ck)> )
    ]

rule Reveal_DPoP:
    [ !CDk(Cl, ~dk) ] --[ RevealDPoP(Cl) ]-> [ Out(~dk) ]

/* ---- AS: トークン発行。pending 消費(単回) + ユーザ承認検証 + mandate 束縛(承認 m = 保存 m)
        + クライアント認証 → token を (U, cnf.jkt) 束縛で発行。token 平文配送（窃取可能）。 ---- */
rule AS_IssueToken:
    [ Pending(arid, Cl, U, m)
    , !UserPub(U, upk)
    , !ClientPub(Cl, cpk)
    , In( <'approval', arid, mapproved, asig> )
    , In( <'tokenpoll', Cl, arid, dppub, csig> )
    , Fr(~at)
    ]
  --[ Eq(verify(asig, <'approve', arid, mapproved>, upk), true)   // ユーザ承認の署名検証
    , Eq(mapproved, m)                                            // mandate 束縛（#3）
    , Eq(verify(csig, <'tokenpoll', Cl, arid, dppub>, cpk), true) // クライアント認証
    , IssueToken(Cl, U, arid, m, ~at, h(dppub)) ]->
    [ !Bound(~at, h(dppub))      // cnf.jkt 束縛（#2）
    , !TokenUser(~at, U)
    , Out(~at)                   // 平文配送（窃取可能）
    ]

/* ---- クライアント: token を DPoP proof 付きで RS へ ---- */
rule C_UseAT:
    let payload = <'dpop', $M, $RU, ~jti, at>
    in
    [ !CDk(Cl, ~dk), In(at), Fr(~jti) ]
  --[ ClientUsesAT(Cl, at) ]->
    [ Out( <'rsreq', at, payload, sign(payload, ~dk), pk(~dk)> ) ]

/* ---- RS: cnf.jkt 一致 + proof 署名 + jti 単回 → リソースをリクエスタ鍵へ暗号化して開放 ---- */
rule RS_Accept:
    let payload = <'dpop', M, RU, jti, at>
    in
    [ !Bound(at, jkt), !TokenUser(at, U), !Resource(U, ~res)
    , In( <'rsreq', at, payload, sig, dppub> )
    ]
  --[ Eq(h(dppub), jkt)                          // cnf.jkt 一致（#2）
    , Eq(verify(sig, payload, dppub), true)       // proof 署名
    , Once(jti)
    , RS_Grant(at, U)
    ]->
    [ Out( aenc(~res, dppub) ) ]

restriction Equality:
    "All x y #i. Eq(x, y) @ #i ==> x = y"
restriction OnceJti:
    "All x #i #j. Once(x) @ #i & Once(x) @ #j ==> #i = #j"

/* ======================== 性質 ======================== */

lemma executable:
  exists-trace
    "Ex at U #g.
        RS_Grant(at, U) @ #g
      & not (Ex Cl #r. RevealDPoP(Cl) @ #r)
      & not (Ex UU #r. RevealUser(UU) @ #r)"

/* (1) エンドツーエンドのリソース秘匿（#3 × #2 の合成）:
   正規ユーザの保護リソースは、DPoP鍵もユーザ鍵も漏れない限り攻撃者に漏れない。 */
lemma comp_resource_secrecy:
    "All U res #i.
        Protected(U, res) @ #i
      & (not (Ex Cl #r. RevealDPoP(Cl) @ #r))
      & (not (Ex UU #r. RevealUser(UU) @ #r))
      ==> not (Ex #j. K(res) @ #j)"

/* (2) binding 完全性: (arid, m) のトークン発行 ⇒ ユーザは (arid, m) を承認していた（鍵漏洩を除く）。
       表示すり替えで未承認 mandate のトークンは得られない。 */
lemma binding_integrity:
    "All Cl U arid m at jkt #i.
        IssueToken(Cl, U, arid, m, at, jkt) @ #i
      ==> (Ex #a. UserApproved(U, arid, m) @ #a) | (Ex #r. RevealUser(U) @ #r)"

/* (3) マンデート単回: 同じ arid から2トークンは出ない（Pending が linear）。 */
lemma mandate_single_use:
    "All Cl U arid m at1 j1 at2 j2 #i #k.
        IssueToken(Cl, U, arid, m, at1, j1) @ #i
      & IssueToken(Cl, U, arid, m, at2, j2) @ #k
      ==> #i = #k"

end
